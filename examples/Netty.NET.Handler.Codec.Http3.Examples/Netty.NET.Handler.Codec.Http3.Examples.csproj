<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CLR: the HTTP/3 programs of codec-http3's test sources (Http3ServerExample and Http3ClientExample of package
    io.netty.handler.codec.http3.example, and Http3SpecTestServer of package io.netty.handler.codec.http3, the server that
    h3spec runs against) are one executable that keeps every program's Main(string[]), as each Java class has its own
    main. C# allows several Main methods only with an explicit startup object, so ExampleLauncher (CLR-only, copied from
    examples/Netty.NET.Example/ExampleLauncher.cs) picks the program by its Java class name and maps -Dname=value arguments to
    GetProperty. The root namespace is that of the module's package, so the example folder is
    Netty.NET.Handler.Codec.Http3.Example; the programs run on the msquic implementation of codec-quic
    (docs/codec-classes-quic-porting.md, Stage 2).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Netty.NET.Handler.Codec.Http3</RootNamespace>
    <StartupObject>Netty.NET.Handler.Codec.Http3.Example.ExampleLauncher</StartupObject>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- codec-http3 brings codec-quic, codec-http, handler, Transport, Buffer and Common. -->
    <ProjectReference Include="..\..\src\Netty.NET.Handler.Codec.Http3\Netty.NET.Handler.Codec.Http3.csproj" />
    <!-- The self-signed certificate of the servers (CertificateBuilder replaces the deprecated SelfSignedCertificate,
         as in Netty.NET.Example's ServerUtil). -->
    <ProjectReference Include="..\..\src\Netty.NET.PkiTesting\Netty.NET.PkiTesting.csproj" />
  </ItemGroup>
</Project>
