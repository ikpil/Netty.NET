<Project Sdk="Microsoft.NET.Sdk">
  <!-- ExampleLauncher selects a QUIC example by its Java class name. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Netty.NET.Handler.Codec.Quic.Example</RootNamespace>
    <StartupObject>Netty.NET.Handler.Codec.Quic.Example.ExampleLauncher</StartupObject>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netty.NET.Handler.Codec.Quic\Netty.NET.Handler.Codec.Quic.csproj" />
    <!-- The self-signed certificate of the server examples (CertificateBuilder replaces the deprecated
         SelfSignedCertificate, as in Netty.NET.Example's ServerUtil). -->
    <ProjectReference Include="..\..\src\Netty.NET.PkiTesting\Netty.NET.PkiTesting.csproj" />
  </ItemGroup>
</Project>
