<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Netty.NET.Transport\Netty.NET.Transport.csproj" />
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Tests" />
    <!-- The codecs that use Java's PromiseCombiner share ExecutorPromiseCombiner, the CLR-only counterpart that completes
         the combined promise on the executor (HttpObjectEncoder, CompressorHttp2ConnectionEncoder,
         Http3FrameToHttpObjectCodec; MessageToMessageEncoder here). -->
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Http" />
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Http2" />
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Http3" />
  </ItemGroup>
</Project>
