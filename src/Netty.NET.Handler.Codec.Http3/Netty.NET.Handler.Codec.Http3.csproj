<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- codec-http3 needs codec-http (which brings codec-compression, handler and codec-base) and codec-classes-quic
         (io.netty.handler.codec.quic), whose API layer is Netty.NET.Handler.Codec.Quic (docs/codec-http3-porting.md,
         docs/codec-classes-quic-porting.md). -->
    <ProjectReference Include="..\Netty.NET.Handler.Codec.Http\Netty.NET.Handler.Codec.Http.csproj" />
    <ProjectReference Include="..\Netty.NET.Handler.Codec.Quic\Netty.NET.Handler.Codec.Quic.csproj" />
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Http3.Tests" />
  </ItemGroup>
</Project>
