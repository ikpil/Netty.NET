<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Netty.NET.Handler.Codec\Netty.NET.Handler.Codec.csproj" />
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Compression.Tests" />
    <!-- codec-http's SPDY header block codec uses java.util.zip.Deflater/Inflater, whose counterparts are the internal
         Deflater/Inflater stand-ins of this assembly (owner decision 2026-11-24). -->
    <InternalsVisibleTo Include="Netty.NET.Handler.Codec.Http" />
  </ItemGroup>
  <ItemGroup>
    <!-- Owner decision 2026-11-23: java.util.zip.Checksum/CRC32/Adler32 are System.IO.Hashing's
         NonCryptographicHashAlgorithm/Crc32/Adler32 (Microsoft, MIT). -->
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>
</Project>
