<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Netty.NET.Common"><HintPath>$(LibraryPath)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireLibrary" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(LibraryPath)')" Text="Supply LibraryPath pointing to the library to measure." />
  </Target>
</Project>
