<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Xunit.v3.AssertMessages" Version="4.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netty.NET.Handler.Codec.Http2\Netty.NET.Handler.Codec.Http2.csproj" />
    <ProjectReference Include="..\..\src\Netty.NET.PkiTesting\Netty.NET.PkiTesting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- codec-http2/src/test/resources/io/netty/handler/codec/http2/testdata/*.json, copied byte for byte. HpackTest
         lists that class-path directory (ResourcesUtil.getFile(HpackTest.class, TEST_DIR).listFiles()), so the files
         are deployed next to the test assembly under the same package path. -->
    <None Include="Resources\testdata\*.json" Link="io\netty\handler\codec\http2\testdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\Netty.NET.Testsuite.Common\LeakPresenceExtension.props" />
</Project>
