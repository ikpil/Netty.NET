<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Xunit.v3.AssertMessages" Version="4.0.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netty.NET.Handler.Codec.Http\Netty.NET.Handler.Codec.Http.csproj" />
    <ProjectReference Include="..\..\src\Netty.NET.PkiTesting\Netty.NET.PkiTesting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- codec-http/src/test/resources/file-0N.txt, copied byte for byte. Java loads them with
         getClass().getResource("/file-01.txt") from the class-path root; they are deployed next to the test assembly. -->
    <None Include="Resources\*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
