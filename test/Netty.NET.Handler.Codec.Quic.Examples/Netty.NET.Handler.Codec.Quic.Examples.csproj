<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CLR: the QUIC examples of codec-native-quic (src/test/java/io/netty/handler/codec/quic/example, package
    io.netty.handler.codec.quic.example) are one executable that keeps every example's Main(string[]), as each Java example
    class has its own main. C# allows several Main methods only with an explicit startup object, so ExampleLauncher
    (CLR-only, copied from src/Netty.NET.Example/ExampleLauncher.cs) picks the example by its Java class name and maps
    -Dname=value arguments to GetProperty (docs/codec-native-quic-porting.md, Examples).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Netty.NET.Handler.Codec.Quic.Example</RootNamespace>
    <StartupObject>Netty.NET.Handler.Codec.Quic.Example.ExampleLauncher</StartupObject>
    <WarningsAsErrors>$(WarningsAsErrors);CS9191</WarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Netty.NET.Handler.Codec.Quic\Netty.NET.Handler.Codec.Quic.csproj" />
    <!-- The self-signed certificate of the server examples (CertificateBuilder replaces the deprecated
         SelfSignedCertificate, as in Netty.NET.Example's ServerUtil). -->
    <ProjectReference Include="..\..\src\Netty.NET.PkiTesting\Netty.NET.PkiTesting.csproj" />
  </ItemGroup>
</Project>
